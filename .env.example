# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# App database (speeches, sections, section sources, voice profiles).
# SQLite on the writing-style-app-db named volume mounted at /data in the api
# container. Four slashes = an absolute path. Only the api reads this.
APP_DATABASE_URL=sqlite+aiosqlite:////data/app.db

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=writing_style
QDRANT_VECTOR_SIZE=1536

# CORS (local `npm run dev` convenience only — not used by the docker-compose/nginx flow)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Gemini embeddings (ingest pipeline -- see ingest/). Auth is via
# Application Default Credentials (`gcloud auth application-default login`,
# or GOOGLE_APPLICATION_CREDENTIALS pointing at a service account key) --
# no API key needed here.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Corpus search: RAG_TOP_K backs the /api/search source picker; BRIEF_TOP_K is
# what the agent's search_corpus tool retrieves per query.
RAG_TOP_K=5
BRIEF_TOP_K=8

# Cap on Anthropic server-side web searches per brief. Each search is billed on
# top of tokens ($10 per 1,000 searches), so this bounds per-brief cost.
# Set to 0 to build briefs from the corpus alone, with no web lookups.
WEB_SEARCH_MAX_USES=5

# Output ceiling for one brief. Too low truncates the brief mid-JSON and the
# request fails validation with fields missing rather than with a length error.
MAX_OUTPUT_TOKENS=16000

# Host port mappings
API_PORT=8000
FRONTEND_PORT=3000
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
